# Copiez ce fichier en `.env` (fait automatiquement par `make up`).
# `.env` est ignoré par Git : ne commitez jamais de vraies valeurs.
# Les valeurs ci-dessous sont des valeurs de DÉVELOPPEMENT LOCAL uniquement.

# --- Base de données ---
POSTGRES_USER=billetterie
POSTGRES_PASSWORD=dev-password-change-me
POSTGRES_DB=billetterie
POSTGRES_PORT=5432

# --- Ports exposés sur 127.0.0.1 ---
WEB_PORT=8080
API_PORT=3000
MAILPIT_UI_PORT=8025

# --- API ---
LOG_LEVEL=info
# Nombre maximal de réservations par adresse IP et par minute (protection de base contre les bots).
RATE_LIMIT_MAX=10
